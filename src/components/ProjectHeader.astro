---
import { FormattedDate } from '../components/Date';
import { Text } from '../components/Typography';
import { Link } from '../components/Links';

export interface Props {
  title: string;
  publishDate: string;
  githubLink: string;
  websiteLink: string;
}

const { title, publishDate, githubLink, websiteLink } = Astro.props;
---

<header class="header">
  <Text as="h1" className="text-xl text-center my-0">{title}</Text>

  <div class="text-center my-0 text-sm">
    {
      githubLink && (
        <Link href={githubLink} className="inline-flex">GitHub</Link>
    
        <Text as="span" colorScheme="gray" className="mx-1">&bull;</Text>
      )
    }
    {
      websiteLink && (
        <Link href={websiteLink} className="inline-flex">Website</Link>
    
        <Text as="span" colorScheme="gray" className="mx-1">&bull;</Text>
      )
    }

    <FormattedDate publishDate={publishDate} client:visible />
  </div>
</header>

<style>
  .header {
    flex: 1;
  }
</style>
